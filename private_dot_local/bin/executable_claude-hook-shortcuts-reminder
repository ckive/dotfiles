#!/bin/bash
# PostToolUse (Edit|Write): remind to update the terminal shortcuts cheatsheet
# whenever kitty.conf changes.
#
# Warn = exit 0 with {"systemMessage": ...}; never blocks. Fails open.

set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0

payload="$(cat)"
file="$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty' 2>/dev/null)"
[ -n "$file" ] || exit 0

case "$file" in
  "$HOME"/.config/kitty/kitty.conf)
    jq -n '{
      systemMessage: "kitty.conf changed. Update TERMINAL-SHORTCUTS.md in the chezmoi source dir (chezmoi source-path) to match, then chezmoi re-add the config (the cheatsheet itself has no $HOME target, so edit it directly in the dotfiles source dir)."
    }'
    ;;
esac

exit 0
