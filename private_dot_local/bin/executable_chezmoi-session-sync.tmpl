#!/bin/bash
# Sync chezmoi configs at Claude Code session start.
# Blocks on conflict; warns on network/other failures.

command -v chezmoi >/dev/null 2>&1 || exit 0

ROLE="{{ get . "role" | default "workstation" }}"

# Agent hosts: the source tracks agent/<host>. Rebase it onto main so Dan's merged
# changes arrive and the open PR stays current. Never blocks an unattended session:
# on conflict, abort and keep running on the last good config.
if [ "$ROLE" = "agent" ]; then
  branch="agent/$(hostname -s)"
  chezmoi git -- rebase --abort >/dev/null 2>&1 || true
  chezmoi git -- fetch --quiet origin 2>/dev/null \
    || { echo "[chezmoi-sync] fetch failed (network?), skipping" >&2; exit 0; }
  chezmoi git -- checkout --quiet -B "$branch" 2>/dev/null
  if chezmoi git -- rebase --quiet origin/main >/dev/null 2>&1; then
    chezmoi git -- push --quiet --force-with-lease -u origin "$branch" >/dev/null 2>&1 || true
  else
    chezmoi git -- rebase --abort >/dev/null 2>&1 || true
    echo "[chezmoi-sync] $branch conflicts with main; resolve in the PR. Using current config." >&2
  fi
  chezmoi apply --force >/dev/null 2>&1 || echo "[chezmoi-sync] chezmoi apply failed" >&2
  exit 0
fi

# Detect stale rebase from previous failed sync
if chezmoi git -- status 2>&1 | grep -q "rebase in progress"; then
  echo "[chezmoi-sync] Previous rebase still in progress" >&2
  echo "  To abort: chezmoi git -- rebase --abort" >&2
  echo "  To continue: chezmoi git -- rebase --continue" >&2
  exit 1
fi

output=$(chezmoi update --force 2>&1)
[ $? -eq 0 ] && exit 0

# Missing upstream tracking. Must be matched BEFORE the conflict test below,
# because git's error text for this case contains the word "rebase" and would
# otherwise be reported as a bogus conflict that blocks every session start.
if echo "$output" | grep -qi "no tracking information"; then
  echo "[chezmoi-sync] Branch has no upstream. Fix once with:" >&2
  echo "  chezmoi git -- branch --set-upstream-to=origin/main main" >&2
  exit 0
fi

# Conflict vs network failure
if echo "$output" | grep -qi -e "conflict" -e "could not apply" -e "rebase"; then
  echo "[chezmoi-sync] Conflict detected:" >&2
  echo "$output" >&2
  echo "Resolve: chezmoi git -- status" >&2
  echo "Skip: chezmoi git -- rebase --abort" >&2
  exit 1
fi

echo "[chezmoi-sync] chezmoi update failed (network?), skipping" >&2
exit 0
