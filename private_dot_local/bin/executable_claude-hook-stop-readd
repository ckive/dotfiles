#!/bin/bash
# Stop: catch anything the PostToolUse hook missed.
# Fails open; never blocks.

set -uo pipefail

command -v chezmoi >/dev/null 2>&1 || exit 0

lock="$HOME/.claude-backup.lock"

if command -v flock >/dev/null 2>&1; then
  flock -w 5 "$lock" chezmoi re-add >/dev/null 2>&1 &
else
  echo "[chezmoi-readd] flock not found; run: brew install flock" >&2
  chezmoi re-add >/dev/null 2>&1 &
fi

exit 0
