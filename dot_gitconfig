# This is Git's per-user configuration file.
# Managed by chezmoi — edit via `chezmoi edit ~/.gitconfig`, then `chezmoi apply`.

# Default identity is GitHub's; repos with a Forgejo remote switch to dan (see includeIf below).
[user]
	name = ckive
	email = danyang2023@u.northwestern.edu
	signingkey = ~/.ssh/id_ed25519_signing.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[includeIf "hasconfig:remote.*.url:ssh://git@git.home.arpa:2222/**"]
	path = ~/.gitconfig-forgejo
[includeIf "hasconfig:remote.*.url:https://git.home.arpa/**"]
	path = ~/.gitconfig-forgejo

[alias]
	s = status
	d = diff
	ds = diff --staged
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate -20
	last = log -1 HEAD
	unstage = reset HEAD --
	amend = commit --amend --no-edit

[core]
	editor = nano
	autocrlf = input

[pull]
	rebase = true

[push]
	default = current

[init]
	defaultBranch = main
