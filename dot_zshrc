# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(git pyvenv-activate fzf zoxide)

source $ZSH/oh-my-zsh.sh

source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

PIPENV_PYTHON="$(pyenv which python)"

#pipenv auto activate plugin enable
pyvenv_auto_activate_enable chpwd

# xc32 compiler for pic32
export PATH="$PATH:/Applications/microchip/xc32/v4.35/bin"

# CE C/Cpp Toolchain Path
export PATH=/Users/dan/Desktop/projects/CEdev/bin:$PATH

export PATH="$HOME/.local/bin:$PATH"

# Added by Antigravity
export PATH="/Users/dan/.antigravity/antigravity/bin:$PATH"

# Shared config (aliases, lllm switcher, claude wrapper)
[ -f "$HOME/.config/shell/common.sh" ] && source "$HOME/.config/shell/common.sh"

# CLAUDE CODE
# equiv of DISABLE_AUTOUPDATER, DISABLE_FEEDBACK_COMMAND, DISABLE_ERROR_REPORTING, and DISABLE_TELEMETRY
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# pnpm
export PNPM_HOME="/Users/dan/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# kimi-code
export PATH="/Users/dan/.kimi-code/bin:$PATH"
