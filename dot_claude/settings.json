{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "default"
  },
  "model": "sonnet",
  "bashOutputMaxChars": 8000,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/chezmoi-session-sync",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-hook-guard-bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-hook-guard-edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-hook-chezmoi-add"
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-hook-shortcuts-reminder"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-hook-stop-readd"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(cat | jq -r '.message // \"Claude Code needs your input\"'); osascript -e \"display notification \\\"$msg\\\" with title \\\"Claude Code\\\"\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd // \"\"'); model=$(echo \"$input\" | jq -r '.model.display_name // \"\"'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); user=$(whoami); host=$(hostname -s); short_cwd=\"${cwd/#$HOME/\\~}\"; ctx_str=$([ -n \"$used\" ] && echo \"ctx: ${used}%\" || echo \"ctx: --\"); printf \"\\033[1;34m%s@%s\\033[0m  \\033[1;32m%s\\033[0m  |  %s  %s\" \"$user\" \"$host\" \"$short_cwd\" \"$model\" \"$ctx_str\""
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoCompactWindow": 300000,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": false,
  "voiceEnabled": true
}
