# macOS packages. Dev CLIs and runtimes are in ~/.config/mise/config.toml, not here.
# The sync runs `brew bundle` when this file changes.
# Apps already in /Applications (installed by hand) are skipped instead of reinstalled.
def installed?(app) = File.exist?("/Applications/#{app}.app")

