#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# ///
"""dotfiles: keep this machine in sync with the public base repo and a private overlay.

Two chezmoi instances share $HOME: the base (default chezmoi config) and an optional overlay
(its own config, state and cache). See README.md and docs/scenarios.md.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fnmatch
import json
import os
import shutil
import socket
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

HOME = Path(os.environ.get("HOME", str(Path.home())))
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state"))
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache"))
STATE = STATE_HOME / "dotfiles"
CONFLICT = STATE / "conflict.json"
LAST = STATE / "last.json"
LOCK = STATE / "sync.lock"
LOCK_STALE_SECONDS = 15 * 60
SNAP_SETTINGS = STATE / "claude-settings.applied.json"
SNAP_MARKETPLACES = STATE / "marketplaces.applied.json"
SNAP_MCP = STATE / "mcp-servers.applied.json"
LAST_DRIFT = STATE / "drift.json"
DRIFT_EVERY_SECONDS = 7 * 24 * 3600

CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"
CLAUDE_JSON = HOME / ".claude.json"
KNOWN_MARKETPLACES = HOME / ".claude" / "plugins" / "known_marketplaces.json"
PORTABLE_SOURCES = ("github", "git", "url")

# Directories whose new files are captured into the private overlay.
SKILL_HOME = HOME / ".config" / "agents" / "skills"
SKILL_LINK_DIRS = (HOME / ".claude" / "skills", HOME / ".agents" / "skills")
CAPTURE_DIRS = tuple(HOME / ".claude" / d for d in ("agents", "commands", "rules"))

# chezmoi source-name attributes, stripped to turn a source path into a target path.
SOURCE_PREFIXES = (
    "after_",
    "before_",
    "create_",
    "empty_",
    "encrypted_",
    "exact_",
    "executable_",
    "external_",
    "literal_",
    "modify_",
    "once_",
    "onchange_",
    "private_",
    "readonly_",
    "remove_",
    "run_",
    "symlink_",
)


# ---------------------------------------------------------------- helpers


def run(cmd: list[str], cwd: Path | None = None, check: bool = False, env: dict | None = None):
    return subprocess.run(
        cmd,
        cwd=cwd,
        capture_output=True,
        text=True,
        check=check,
        env={**os.environ, **(env or {})},
    )


def load_config() -> dict:
    path = CONFIG_HOME / "dotfiles" / "config.toml"
    if not path.exists():
        return {"mode": "push"}
    with path.open("rb") as f:
        return {"mode": "push", **tomllib.load(f)}


def host(cfg: dict) -> str:
    return os.environ.get("DOTFILES_HOST") or cfg.get("host") or socket.gethostname().split(".")[0]


def notify(message: str) -> None:
    log = os.environ.get("DOTFILES_NOTIFY_LOG")
    if log:
        with open(log, "a") as f:
            f.write(message + "\n")
        return
    if sys.platform == "darwin":
        script = f'display notification {json.dumps(message)} with title "dotfiles"'
        run(["osascript", "-e", script])
    elif shutil.which("notify-send") and (
        os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    ):
        run(["notify-send", "dotfiles", message])


def target_name(source_rel: str) -> str:
    """Map a source path like home/private_dot_config/x.tmpl to .config/x."""
    parts = source_rel.split("/")
    if parts and parts[0] == "home":
        parts = parts[1:]
    out = []
    for part in parts:
        changed = True
        while changed:
            changed = False
            for prefix in SOURCE_PREFIXES:
                if part.startswith(prefix):
                    part, changed = part[len(prefix) :], True
        if part.startswith("dot_"):
            part = "." + part[4:]
        out.append(part.removesuffix(".tmpl"))
    return "/".join(out)


def read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


# ---------------------------------------------------------------- instances


@dataclass
class Instance:
    name: str
    flags: list[str]

    def chezmoi(self, *args: str, check: bool = False):
        return run(["chezmoi", *self.flags, *args], check=check)

    @property
    def repo(self) -> Path:
        out = self.chezmoi("git", "--", "rev-parse", "--show-toplevel", check=True)
        return Path(out.stdout.strip())

    def git(self, *args: str, check: bool = False, env: dict | None = None):
        return run(["git", *args], cwd=self.repo, check=check, env=env)

    def managed(self) -> set[Path]:
        out = self.chezmoi("managed", "--path-style", "absolute")
        return {Path(p) for p in out.stdout.splitlines() if p}

    def apply(self) -> None:
        out = self.chezmoi("apply", "--force", "--no-tty")
        if out.returncode != 0:
            add_warning(f"{self.name}: chezmoi apply failed: {out.stderr.strip()[:300]}")


def instances(cfg: dict) -> list[Instance]:
    """Overlay first, then base: the base renders files that read overlay fragments."""
    result = []
    overlay = cfg.get("overlay")
    if overlay:
        cdir = CONFIG_HOME / "chezmoi"
        result.append(
            Instance(
                overlay,
                [
                    "--config",
                    str(cdir / f"{overlay}.toml"),
                    "--persistent-state",
                    str(cdir / f"{overlay}-state.boltdb"),
                    "--cache",
                    str(CACHE_HOME / f"chezmoi-{overlay}"),
                ],
            )
        )
    result.append(Instance("base", []))
    return result


def source_dir(config: Path) -> Path | None:
    try:
        with config.open("rb") as f:
            source = tomllib.load(f).get("sourceDir")
    except (OSError, tomllib.TOMLDecodeError):
        return None
    return Path(source).expanduser() if source else None


def base_repo() -> Path:
    return source_dir(CONFIG_HOME / "chezmoi" / "chezmoi.toml") or HOME / ".local/share/chezmoi"


def overlay_repo(cfg: dict) -> Path | None:
    """Working tree of the overlay, read from its chezmoi config (no chezmoi call needed)."""
    overlay = cfg.get("overlay")
    if not overlay:
        return None
    return source_dir(CONFIG_HOME / "chezmoi" / f"{overlay}.toml")


def instance_named(cfg: dict, name: str) -> Instance:
    for inst in instances(cfg):
        if inst.name == name:
            return inst
    raise SystemExit(f"dotfiles: no instance named {name!r}")


# ---------------------------------------------------------------- state


_warnings: list[str] = []


def add_warning(message: str) -> None:
    _warnings.append(message)


class Lock:
    def __enter__(self) -> bool:
        STATE.mkdir(parents=True, exist_ok=True)
        try:
            LOCK.mkdir()
        except FileExistsError:
            if not self._stale():
                self.held = False
                return False
            shutil.rmtree(LOCK, ignore_errors=True)
            LOCK.mkdir()
        (LOCK / "pid").write_text(json.dumps({"pid": os.getpid()}))
        self.held = True
        return True

    def __exit__(self, *exc) -> None:
        if self.held:
            shutil.rmtree(LOCK, ignore_errors=True)

    @staticmethod
    def _stale() -> bool:
        info = read_json(LOCK / "pid") or {}
        try:
            age = dt.datetime.now().timestamp() - LOCK.stat().st_mtime
        except OSError:
            return True
        if age > LOCK_STALE_SECONDS:
            return True
        pid = info.get("pid")
        if not isinstance(pid, int):
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        except PermissionError:
            return False
        return False


# ---------------------------------------------------------------- claude settings
#
# ~/.claude/settings.json is built from two fragments: <base>/claude/settings.json and
# <overlay>/claude/settings.json. Dicts merge recursively, lists are joined without duplicates,
# and the overlay wins for plain values. Edits Claude makes (/plugin, /model, ...) are captured
# into the overlay fragment by comparing the live file with the copy saved after the last apply,
# so additions *and* removals travel to other machines.


def deep_merge(base, over):
    if isinstance(base, dict) and isinstance(over, dict):
        out = dict(base)
        for k, v in over.items():
            out[k] = deep_merge(base[k], v) if k in base else v
        return out
    if isinstance(base, list) and isinstance(over, list):
        return base + [x for x in over if x not in base]
    return over


def capture_delta(ov, base, snap, live, path: str):
    """Fold the change snap -> live into the overlay fragment `ov`; returns the new fragment."""
    if isinstance(snap, dict) and isinstance(live, dict):
        out = dict(ov) if isinstance(ov, dict) else {}
        base = base if isinstance(base, dict) else {}
        for k in list(snap) + [k for k in live if k not in snap]:
            here = f"{path}.{k}" if path else k
            if k not in live:
                out.pop(k, None)
                if k in base:
                    add_warning(f"{here} comes from the public base; remove it there to drop it")
            elif k not in snap:
                out[k] = live[k]
            elif live[k] != snap[k]:
                out[k] = capture_delta(out.get(k), base.get(k), snap[k], live[k], here)
        return out
    if isinstance(snap, list) and isinstance(live, list):
        out = list(ov) if isinstance(ov, list) else []
        base = base if isinstance(base, list) else []
        for x in live:
            if x not in snap and x not in out and x not in base:
                out.append(x)
        for x in snap:
            if x not in live:
                if x in out:
                    out.remove(x)
                elif x in base:
                    add_warning(f"{path}: {json.dumps(x)} comes from the public base")
        return out
    return live


def fragment_path(repo: Path | None, name: str) -> Path | None:
    return repo / "claude" / name if repo else None


def merged_claude_settings(cfg: dict) -> dict:
    base = read_json(base_repo() / "claude" / "settings.json") or {}
    ov_path = fragment_path(overlay_repo(cfg), "settings.json")
    over = (read_json(ov_path) if ov_path else None) or {}
    return deep_merge(base, over)


def cmd_render_claude_settings(_args) -> int:
    """chezmoi modify_ script: current file on stdin, new file on stdout."""
    text = sys.stdin.read()
    try:
        live = json.loads(text) if text.strip() else {}
    except ValueError:
        live = {}
    merged = merged_claude_settings(load_config())
    snap = read_json(SNAP_SETTINGS) or {}
    result = dict(merged)
    for k, v in live.items():
        # Keep runtime keys nobody manages; drop ones that a repo managed but no longer lists.
        if k not in merged and k not in snap:
            result[k] = v
    sys.stdout.write(json.dumps(result, indent=2) + "\n")
    return 0


def portable_marketplaces() -> dict:
    known = read_json(KNOWN_MARKETPLACES) or {}
    return {
        name: {"source": entry["source"]}
        for name, entry in known.items()
        if name != "claude-plugins-official"
        and isinstance(entry, dict)
        and entry.get("source", {}).get("source") in PORTABLE_SOURCES
    }


def capture_claude_settings(cfg: dict) -> None:
    ov_path = fragment_path(overlay_repo(cfg), "settings.json")
    if not ov_path:
        return
    ov = read_json(ov_path) or {}
    new = ov
    base = read_json(base_repo() / "claude" / "settings.json") or {}
    live, snap = read_json(CLAUDE_SETTINGS), read_json(SNAP_SETTINGS)
    if live is not None and snap is not None:
        new = capture_delta(ov, base, snap, live, "")
    # /plugin marketplace add only records the marketplace in known_marketplaces.json.
    if SNAP_MARKETPLACES.exists():
        before, now = read_json(SNAP_MARKETPLACES) or {}, portable_marketplaces()
        markets = dict(new.get("extraKnownMarketplaces", {}))
        for name in now.keys() - before.keys():
            if name not in base.get("extraKnownMarketplaces", {}):
                markets[name] = now[name]
        for name in before.keys() - now.keys():
            markets.pop(name, None)
        if markets or "extraKnownMarketplaces" in new:
            new = {**new, "extraKnownMarketplaces": markets}
    if new != ov:
        write_json(ov_path, new)


def snapshot_claude_settings() -> None:
    live = read_json(CLAUDE_SETTINGS)
    if live is not None:
        write_json(SNAP_SETTINGS, live)
    write_json(SNAP_MARKETPLACES, portable_marketplaces())


# ---------------------------------------------------------------- MCP servers
#
# User-scope MCP servers live in ~/.claude.json, which also holds OAuth state and IDs, so it is
# never tracked. Servers are copied to <overlay>/claude/mcp-servers.json instead. A server whose
# env/headers hold a literal value (likely a token) stays on its machine.


def is_portable_server(server: dict) -> bool:
    values = [*server.get("env", {}).values(), *server.get("headers", {}).values()]
    return all(str(v).startswith("${") for v in values)


def live_mcp_servers() -> dict:
    return (read_json(CLAUDE_JSON) or {}).get("mcpServers", {}) or {}


def capture_mcp(cfg: dict) -> None:
    path = fragment_path(overlay_repo(cfg), "mcp-servers.json")
    if not path:
        return
    live = live_mcp_servers()
    for name in sorted(n for n, s in live.items() if not is_portable_server(s)):
        add_warning(f"not syncing MCP server {name}: literal value in env/headers (use ${{VAR}})")
    portable = {n: s for n, s in live.items() if is_portable_server(s)}
    snap = read_json(SNAP_MCP) or {}
    frag = read_json(path) or {}
    new = dict(frag)
    for name, server in portable.items():
        if snap.get(name) != server:
            new[name] = server
    for name in snap.keys() - portable.keys():
        new.pop(name, None)
    if new != frag or (portable and not path.exists()):
        write_json(path, new)


def apply_mcp(cfg: dict) -> None:
    path = fragment_path(overlay_repo(cfg), "mcp-servers.json")
    if not path:
        return
    frag = read_json(path) or {}
    snap = read_json(SNAP_MCP) or {}
    data = read_json(CLAUDE_JSON)
    if data is None:
        if not frag:
            return
        data = {}
    servers = dict(data.get("mcpServers", {}) or {})
    for name in snap.keys() - frag.keys():
        servers.pop(name, None)  # removed on another machine
    servers.update(frag)
    if servers != (data.get("mcpServers") or {}):
        data["mcpServers"] = servers
        write_json(CLAUDE_JSON, data)
        CLAUDE_JSON.chmod(0o600)
    write_json(SNAP_MCP, {n: s for n, s in servers.items() if is_portable_server(s)})


# ---------------------------------------------------------------- sync


# What the sync publishes from a repo: config, not code or stray files. Edits to bin/, tests/
# or docs/ are yours to commit; tool output dropped in the repo (rmlint.json) stays local.
SYNC_PATHS = ("home", "packages", "claude", "macos", "drift-ignore")


def commit_all(inst: Instance, who: str, message: str | None = None) -> None:
    tracked = set(inst.git("ls-files").stdout.splitlines())
    paths = [
        p
        for p in SYNC_PATHS
        if (inst.repo / p).exists() or any(t == p or t.startswith(p + "/") for t in tracked)
    ]
    if paths:
        inst.git("add", "--all", "--", *paths)
    staged = inst.git("diff", "--cached", "--name-only").stdout.split()
    if not staged:
        return
    if not message:
        names = [target_name(p) for p in staged]
        summary = ", ".join(names[:3]) + (f" +{len(names) - 3} more" if len(names) > 3 else "")
        message = f"chore(sync): {who}: {summary}"
    inst.git("commit", "-q", "-m", message, check=True)


def has_upstream(inst: Instance) -> bool:
    return inst.git("rev-parse", "--abbrev-ref", "@{u}").returncode == 0


def ahead_behind(inst: Instance) -> tuple[int, int]:
    out = inst.git("rev-list", "--left-right", "--count", "HEAD...@{u}").stdout.split()
    return (int(out[0]), int(out[1])) if len(out) == 2 else (0, 0)


def sync_repo(inst: Instance, cfg: dict, first: bool = False) -> dict | None:
    """Commit, pull and push one repo. Returns a conflict record, or None.

    On a machine's first sync nothing in $HOME is captured: the repo versions are installed
    over whatever config the machine had before.
    """
    push = cfg["mode"] == "push"
    if push and not first:
        # Edits made in the repo itself go first, and are applied before re-add, so the older
        # copy in $HOME can't overwrite them.
        edited = inst.git("status", "--porcelain", "--untracked-files=all", "--", "home")
        sources = [line[3:].split(" -> ")[-1] for line in edited.stdout.splitlines()]
        if sources:
            commit_all(inst, host(cfg))
            targets = {str(HOME / target_name(s)) for s in sources}
            existing = [t for t in targets if inst.chezmoi("source-path", t).returncode == 0]
            if existing:
                inst.chezmoi("apply", "--force", "--no-tty", *existing)
        re_add = inst.chezmoi("re-add", "--no-tty", "--exclude", "externals")
        if re_add.returncode != 0:
            add_warning(f"{inst.name}: chezmoi re-add failed: {re_add.stderr.strip()[:300]}")
        commit_all(inst, host(cfg))
    if inst.git("fetch", "-q", "origin").returncode != 0:
        return None  # offline: try again next time
    if not has_upstream(inst):
        add_warning(f"{inst.name}: branch has no upstream")
        return None
    ahead, behind = ahead_behind(inst)
    if not push:
        if behind:
            inst.git("reset", "-q", "--hard", "@{u}")
        return None
    if behind and ahead:
        if inst.git("rebase", "-q", "--autostash", "@{u}").returncode != 0:
            files = inst.git("diff", "--name-only", "--diff-filter=U").stdout.split()
            inst.git("rebase", "--abort")
            return {
                "instance": inst.name,
                "files": files,
                "targets": [target_name(f) for f in files],
                "at": dt.datetime.now().isoformat(timespec="seconds"),
            }
    elif behind:
        inst.git("merge", "-q", "--ff-only", "--autostash", "@{u}")
    if ahead_behind(inst)[0] and inst.git("push", "-q").returncode != 0:
        add_warning(f"{inst.name}: push failed; will retry")
    return None


def capture(cfg: dict) -> None:
    """Save new skills/agents/commands/rules to the private overlay."""
    insts = instances(cfg)
    if len(insts) < 2:
        return
    overlay = insts[0]
    managed = set().union(*(i.managed() for i in insts))

    for name in _new_skills(managed):
        _adopt_skill(overlay, name)

    for d in CAPTURE_DIRS:
        if not d.is_dir():
            continue
        new = [str(p) for p in d.rglob("*") if p.is_file() and p not in managed]
        if new:
            out = overlay.chezmoi("add", "--no-tty", *new)
            if out.returncode != 0:
                add_warning(f"could not save {', '.join(new)}: {out.stderr.strip()[:300]}")


def _new_skills(managed: set[Path]) -> list[str]:
    names = set()
    for d in (SKILL_HOME, *SKILL_LINK_DIRS):
        if not d.is_dir():
            continue
        for p in d.iterdir():
            is_skill = p.is_dir() and not p.is_symlink() and (p / "SKILL.md").exists()
            if is_skill and p not in managed and (p / "SKILL.md") not in managed:
                names.add(p.name)
    return sorted(names)


def _adopt_skill(overlay: Instance, name: str) -> None:
    """Store the skill once under ~/.config/agents/skills and link it into each agent."""
    home = SKILL_HOME / name
    for d in SKILL_LINK_DIRS:
        p = d / name
        if p.is_dir() and not p.is_symlink():
            if home.exists():
                add_warning(f"skill {name} exists in two places; kept {home}")
                continue
            home.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(p), str(home))
    out = overlay.chezmoi("add", "--no-tty", str(home))
    if out.returncode != 0:
        add_warning(f"could not save skill {name}: {out.stderr.strip()[:300]}")
        return
    source_home = overlay.repo / "home"
    for d in SKILL_LINK_DIRS:
        rel = d.relative_to(HOME)
        src = source_home / source_dir_name(rel) / f"symlink_{name}.tmpl"
        src.parent.mkdir(parents=True, exist_ok=True)
        src.write_text("{{ .chezmoi.homeDir }}/" + str(home.relative_to(HOME)) + "\n")
        link = d / name
        if not link.exists() and not link.is_symlink():
            link.parent.mkdir(parents=True, exist_ok=True)
            link.symlink_to(home)


def source_dir_name(rel: Path) -> str:
    """Source-state name of a target directory, e.g. .claude/skills -> dot_claude/skills."""
    return "/".join("dot_" + p[1:] if p.startswith(".") else p for p in rel.parts)


def do_sync(cfg: dict) -> None:
    """One sync pass. Caller holds the lock."""
    first = not LAST.exists()
    if cfg["mode"] == "push" and not first:
        capture(cfg)
        capture_claude_settings(cfg)
        capture_mcp(cfg)
    conflict = None
    for inst in instances(cfg):
        c = sync_repo(inst, cfg, first)
        if c and not conflict:
            conflict = c
    for inst in instances(cfg):
        if not conflict or conflict["instance"] != inst.name:
            inst.apply()
    apply_mcp(cfg)
    snapshot_claude_settings()
    if conflict:
        write_json(CONFLICT, conflict)
        notify(f"Clash in {', '.join(conflict['targets'])}. Run: dotfiles resolve")
    weekly_drift(cfg)
    write_json(
        LAST,
        {
            "at": dt.datetime.now().isoformat(timespec="seconds"),
            "warnings": _warnings,
        },
    )


def cmd_sync(_args) -> int:
    cfg = load_config()
    with Lock() as got:
        if not got:
            print("dotfiles: sync already running")
            return 0
        if CONFLICT.exists():
            print(banner_text(read_json(CONFLICT) or {}))
            return 0
        do_sync(cfg)
    return 0


# ---------------------------------------------------------------- promote / drift


def cmd_promote(args) -> int:
    cfg = load_config()
    insts = instances(cfg)
    if len(insts) < 2:
        print("dotfiles: no overlay configured; nothing to promote from")
        return 1
    overlay, base = insts
    path = Path(os.path.abspath(os.path.expanduser(args.path)))
    with Lock() as got:
        if not got:
            print("dotfiles: sync running; try again in a moment")
            return 1
        if path.parent in (SKILL_HOME, *SKILL_LINK_DIRS):
            name = path.name
            targets = [SKILL_HOME / name, *(d / name for d in SKILL_LINK_DIRS)]
            overlay.chezmoi("forget", "--force", "--no-tty", *map(str, targets))
            out = base.chezmoi("add", "--no-tty", str(SKILL_HOME / name))
            for d in SKILL_LINK_DIRS:
                src = base.repo / "home" / source_dir_name(d.relative_to(HOME))
                src.mkdir(parents=True, exist_ok=True)
                (src / f"symlink_{name}.tmpl").write_text(
                    "{{ .chezmoi.homeDir }}/" + str((SKILL_HOME / name).relative_to(HOME)) + "\n"
                )
        else:
            name = str(path.relative_to(HOME)) if path.is_relative_to(HOME) else str(path)
            overlay.chezmoi("forget", "--force", "--no-tty", str(path))
            out = base.chezmoi("add", "--no-tty", str(path))
        if out.returncode != 0:
            print(f"dotfiles: could not add to the public base: {out.stderr.strip()}")
            return 1
        commit_all(base, host(cfg), f"feat(promote): {name}")
        commit_all(overlay, host(cfg), f"chore(promote): move {name} to the public base")
        do_sync(cfg)
    print(f"dotfiles: {name} is now in the public base")
    return 0


def drift_ignores(cfg: dict) -> list[str]:
    """Globs from drift-ignore in each repo: generic ones in the base, yours in the overlay."""
    globs = []
    for inst in instances(cfg):
        f = inst.repo / "drift-ignore"
        if f.exists():
            lines = (line.strip() for line in f.read_text().splitlines())
            globs += [line.rstrip("/") for line in lines if line and not line.startswith("#")]
    return globs


def drift(cfg: dict) -> list[str]:
    """Config under $HOME that no instance manages, ignores or lists in drift-ignore.

    Only dot-paths count: ~/Music or ~/Desktop hold your files, not config. Empty
    directories are skipped too.
    """
    sets = []
    for inst in instances(cfg):
        out = inst.chezmoi("unmanaged", "--path-style", "absolute", str(HOME))
        sets.append({Path(p) for p in out.stdout.splitlines() if p})
    common = set.intersection(*sets) if sets else set()
    globs = drift_ignores(cfg)

    def ignored(rel: str) -> bool:
        return any(fnmatch.fnmatch(rel, g) or rel.startswith(g + "/") for g in globs)

    found = []
    for p in common:
        if not p.is_relative_to(HOME):
            continue
        rel = str(p.relative_to(HOME))
        if not rel.startswith(".") or ignored(rel):
            continue
        if p.is_dir():
            # A folder counts only if it holds a file that isn't ignored (keys in ~/.ssh are).
            files = (f for f in p.rglob("*") if f.is_file())
            if all(ignored(str(f.relative_to(HOME))) for f in files):
                continue
        found.append(rel)
    return sorted(found)


def weekly_drift(cfg: dict) -> None:
    last = read_json(LAST_DRIFT) or {}
    now = dt.datetime.now().timestamp()
    if now - last.get("at", 0) < DRIFT_EVERY_SECONDS:
        return
    found = drift(cfg)
    write_json(LAST_DRIFT, {"at": now, "count": len(found)})
    if found and last:
        notify(f"{len(found)} untracked config paths. Run: dotfiles drift")


def cmd_drift(args) -> int:
    cfg = load_config()
    if args.ignore:
        target = Path(args.ignore).expanduser()
        rel = str(target.relative_to(HOME)) if target.is_absolute() else args.ignore
        f = instances(cfg)[0].repo / "drift-ignore"
        text = f.read_text() if f.exists() else ""
        if rel not in text.splitlines():
            f.write_text(text + ("" if not text or text.endswith("\n") else "\n") + rel + "\n")
        print(f"dotfiles: drift will skip {rel} (saved in {f}, synced to your machines)")
        return 0
    for p in drift(cfg):
        print(p)
    return 0


# ---------------------------------------------------------------- status / resolve


def banner_text(conflict: dict) -> str:
    return f"dotfiles: clash in {', '.join(conflict.get('targets', []))}, run: dotfiles resolve"


def cmd_status(args) -> int:
    conflict = read_json(CONFLICT) if CONFLICT.exists() else None
    last = read_json(LAST) or {}
    if args.banner:
        if conflict:
            print(banner_text(conflict))
        return 0
    if conflict:
        print(f"Clash in {', '.join(conflict['targets'])} ({conflict['instance']} repo).")
        print("Run: dotfiles resolve")
    print(f"Last sync: {last.get('at', 'never')}")
    for w in last.get("warnings", []):
        print(f"warning: {w}")
    return 1 if conflict else 0


CHOICES = {"1": "mine", "2": "theirs", "3": "merge"}


def cmd_resolve(args) -> int:
    conflict = read_json(CONFLICT) if CONFLICT.exists() else None
    if not conflict:
        print("dotfiles: nothing to resolve")
        return 0
    cfg = load_config()
    inst = instance_named(cfg, conflict["instance"])
    choice = args.choice
    if not choice:
        for f in conflict["files"]:
            print(f"--- {target_name(f)}: this machine vs. the other one ---")
            print(inst.git("diff", "@{u}", "HEAD", "--", f).stdout)
        print("1) keep mine   2) take theirs   3) merge by hand")
        choice = CHOICES.get(input("choice [1-3]: ").strip())
        if not choice:
            print("dotfiles: no choice made")
            return 1

    if choice == "mine":
        ok = inst.git("rebase", "-q", "-X", "theirs", "@{u}").returncode == 0
    elif choice == "theirs":
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        for t in conflict["targets"]:
            src = HOME / t
            if src.is_file():
                dest = STATE / "conflicts" / stamp / t
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest)
        ok = inst.git("rebase", "-q", "-X", "ours", "@{u}").returncode == 0
    else:
        ok = _merge_by_hand(inst)
    if not ok:
        inst.git("rebase", "--abort")
        print("dotfiles: could not finish automatically; nothing changed. Try another choice.")
        return 1

    if ahead_behind(inst)[0] and inst.git("push", "-q").returncode != 0:
        print("dotfiles: resolved locally; push failed, the next sync will retry")
    CONFLICT.unlink(missing_ok=True)
    for i in instances(cfg):
        i.apply()
    print("dotfiles: resolved")
    return 0


def _merge_by_hand(inst: Instance) -> bool:
    editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
    if inst.git("rebase", "-q", "--autostash", "@{u}").returncode == 0:
        return True
    while True:
        files = inst.git("diff", "--name-only", "--diff-filter=U").stdout.split()
        if not files:
            return False
        for f in files:
            path = inst.repo / f
            if subprocess.run([editor, str(path)]).returncode != 0:
                return False
            if "<<<<<<<" in path.read_text() or ">>>>>>>" in path.read_text():
                print(f"dotfiles: {target_name(f)} still has conflict markers")
                return False
            inst.git("add", "--", f)
        step = inst.git("rebase", "--continue", env={"GIT_EDITOR": "true"})
        if step.returncode == 0:
            return True


# ---------------------------------------------------------------- main


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="dotfiles", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("sync", help="save local edits, pull other machines' changes, apply")
    p = sub.add_parser("status", help="show sync health")
    p.add_argument("--banner", action="store_true", help="one line, only if action is needed")
    p = sub.add_parser("resolve", help="fix a clash between machines")
    p.add_argument("--choice", choices=["mine", "theirs", "merge"])
    p = sub.add_parser("promote", help="move a file or skill from the private overlay to the base")
    p.add_argument("path")
    p = sub.add_parser("drift", help="list config under $HOME that nothing tracks or ignores")
    p.add_argument("--ignore", metavar="PATH", help="never list PATH again (saved and synced)")
    p = sub.add_parser("ov", help="run chezmoi against the overlay, e.g. dotfiles ov add <path>")
    p.add_argument("chezmoi_args", nargs=argparse.REMAINDER)
    sub.add_parser("render-claude-settings", help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    return {
        "sync": cmd_sync,
        "status": cmd_status,
        "resolve": cmd_resolve,
        "promote": cmd_promote,
        "drift": cmd_drift,
        "ov": cmd_ov,
        "render-claude-settings": cmd_render_claude_settings,
    }[args.cmd](args)


def cmd_ov(args) -> int:
    insts = instances(load_config())
    if len(insts) < 2:
        print("dotfiles: no overlay configured")
        return 1
    return subprocess.run(["chezmoi", *insts[0].flags, *args.chezmoi_args]).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
