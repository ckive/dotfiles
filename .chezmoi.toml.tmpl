{{- /*
  Rendered by `chezmoi init` into ~/.config/chezmoi/chezmoi.toml.

  NOTE the bootstrap chicken-and-egg: sourceDir lives in this config, but on a new
  machine the config does not exist until init has already run. So the first
  invocation must pass --source explicitly:

    chezmoi init --apply --source ~/Documents/dotfiles git@github.com:ckive/dotfiles.git
*/ -}}
{{- $role := promptStringOnce . "role" "role" "workstation" -}}
{{- if not (has $role (list "workstation" "agent")) -}}
{{-   fail (printf "role must be workstation or agent, got %q" $role) -}}
{{- end }}
sourceDir = {{ printf "%s/Documents/dotfiles" .chezmoi.homeDir | quote }}

# role decides only git flow and which role-gated hook scripts act:
#   workstation — source tracks main; autoPush publishes directly.
#   agent       — source tracks agent/<hostname>; autoPush goes to that branch and
#                 claude-hook-agent-pr opens a PR for Dan. Nothing reaches main unreviewed.
# Non-interactive (Ansible): chezmoi init --apply --promptString role=agent ...
[data]
    role = {{ $role | quote }}

[git]
    autoCommit = true
    autoPush = true

[add]
    # Hard-fail rather than warn if an API-key-shaped string is ever added.
    # Deliberate: the PostToolUse hook runs chezmoi add unattended, so a warning
    # would scroll past unseen.
    secrets = "error"
