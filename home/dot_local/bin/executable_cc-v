#!/bin/bash
# cc-v: run Claude Code against another Anthropic-compatible API for one session.
# Plain `claude` is untouched; nothing global changes.
#
#   cc-v <provider> [claude args...]   launch claude on <provider>
#   cc-v list                          providers, and which have a key
#   cc-v set-key <provider>            store a key (hidden prompt, chmod 600)
#
# A provider is ~/.config/cc-v/providers/<name>.env (KEY=VALUE lines, synced by dotfiles).
# CC_V_PROXY=1 in it routes the session through cc-v-proxy, which fixes requests up.
# Its key is ~/.config/cc-v/<name>.secret (never synced). Lines are exported, never eval'd.

set -euo pipefail

dir="$HOME/.config/cc-v"
providers="$dir/providers"

die() {
  echo "cc-v: $*" >&2
  exit 1
}

names() {
  local f
  for f in "$providers"/*.env; do
    [ -e "$f" ] && basename "$f" .env
  done
  return 0
}

usage() {
  echo "usage: cc-v <provider> [claude args...] | cc-v list | cc-v set-key <provider>" >&2
  echo "providers: $(names | tr '\n' ' ')" >&2
  exit 2
}

cmd="${1:-}"
[ -n "$cmd" ] || usage
shift

case "$cmd" in
  -h | --help) usage ;;
  list)
    for name in $(names); do
      if [ -s "$dir/$name.secret" ]; then
        echo "$name  key stored"
      else
        echo "$name  no key"
      fi
    done
    exit 0
    ;;
  set-key)
    name="${1:-}"
    [ -n "$name" ] || usage
    [ -f "$providers/$name.env" ] || die "unknown provider '$name'. Known: $(names | tr '\n' ' ')"
    if [ -t 0 ]; then
      read -rsp "API key for $name: " key
      echo >&2
    else
      read -r key
    fi
    [ -n "$key" ] || die "empty key, nothing stored"
    mkdir -p "$dir"
    (
      umask 077
      printf '%s\n' "$key" >"$dir/$name.secret"
    )
    chmod 600 "$dir/$name.secret"
    echo "stored key for $name"
    exit 0
    ;;
esac

name="$cmd"
env_file="$providers/$name.env"
secret="$dir/$name.secret"
[ -f "$env_file" ] || die "unknown provider '$name'. Known: $(names | tr '\n' ' ')"
[ -s "$secret" ] || die "no key for $name. Run: cc-v set-key $name"

while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in '' | '#'*) continue ;; esac
  key="${line%%=*}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad line in $env_file: $line"
  export "$key=${line#*=}"
done <"$env_file"

unset ANTHROPIC_API_KEY
ANTHROPIC_AUTH_TOKEN="$(head -n1 "$secret")"
export ANTHROPIC_AUTH_TOKEN

# CC_V_PROXY=1: the provider needs request fixups, so claude talks to cc-v-proxy instead.
if [ "${CC_V_PROXY:-}" != 1 ]; then
  exec claude "$@"
fi
unset CC_V_PROXY

port_file="$(mktemp "${TMPDIR:-/tmp}/cc-v.XXXXXX")"
rm -f "$port_file"
mkdir -p "$HOME/.local/state/cc-v"
cc-v-proxy "$ANTHROPIC_BASE_URL" "$port_file" "$$" 2>>"$HOME/.local/state/cc-v/proxy.log" &
proxy=$!
trap 'kill "$proxy" 2>/dev/null; rm -f "$port_file"' EXIT

for _ in $(seq 50); do
  [ -s "$port_file" ] && break
  kill -0 "$proxy" 2>/dev/null || die "cc-v-proxy failed to start; see ~/.local/state/cc-v/proxy.log"
  sleep 0.1
done
[ -s "$port_file" ] || die "cc-v-proxy did not start within 5s"

ANTHROPIC_BASE_URL="http://127.0.0.1:$(cat "$port_file")"
export ANTHROPIC_BASE_URL
status=0
claude "$@" || status=$?
exit "$status"
