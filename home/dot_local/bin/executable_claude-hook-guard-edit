#!/bin/bash
# PreToolUse (Edit|Write): block writing key-shaped strings into config that gets synced.
# Complements chezmoi's add.secrets="error", which only fires when a file is added.
#
# Exit 2 = block, stderr is the reason. Exit 0 = allow. Fails open without jq.

set -uo pipefail

command -v jq >/dev/null 2>&1 || exit 0

payload="$(cat)"
file="$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty' 2>/dev/null)"
[ -n "$file" ] || exit 0

content="$(printf '%s' "$payload" | jq -r '.tool_input.content // .tool_input.new_string // empty' 2>/dev/null)"
[ -n "$content" ] || exit 0

case "$file" in
  */.claude/* | */.codex/* | */.gemini/* | */.agents/* | */.config/* | */dotfiles*/* | \
  */.zshrc | */.zprofile | */.zshenv | */.bashrc | */.gitconfig | */.claude.json)
    if printf '%s' "$content" | grep -qE 'sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|gh[ousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[abposr]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
      echo "BLOCKED by guard-edit: content looks like a live credential." >&2
      echo "File: $file" >&2
      echo "This config is synced to GitHub; a secret here would be published." >&2
      echo "Reference an environment variable instead, e.g. \"\${GITHUB_TOKEN}\"." >&2
      exit 2
    fi
    ;;
esac

exit 0
