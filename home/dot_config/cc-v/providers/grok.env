# xAI Grok via its Anthropic-compatible /v1/messages endpoint.
# The key comes from ~/.config/cc-v/grok.secret (`cc-v set-key grok`).
# Models your key can use: curl https://api.x.ai/v1/models -H "Authorization: Bearer <key>"
ANTHROPIC_BASE_URL=https://api.x.ai
ANTHROPIC_MODEL=grok-4.7
ANTHROPIC_DEFAULT_OPUS_MODEL=grok-4.7
ANTHROPIC_DEFAULT_SONNET_MODEL=grok-4.7
ANTHROPIC_DEFAULT_HAIKU_MODEL=grok-4.20-0309-non-reasoning
CLAUDE_CODE_SUBAGENT_MODEL=grok-4.7
