[Unit]
Description=dotfiles sync (save local edits, pull other machines' changes, apply)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH={{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart={{ .chezmoi.homeDir }}/.local/bin/dotfiles sync
Nice=10
