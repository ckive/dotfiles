# Login shells: put Homebrew on PATH where it exists.
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x $brew ]] && { eval "$($brew shellenv)"; break; }
done
unset brew

# mise tools for non-interactive shells (scripts, ssh commands, agents). Interactive shells
# also run `mise activate` in .zshrc, which puts the real install dirs ahead of these shims.
path=("$HOME/.local/share/mise/shims" $path)
