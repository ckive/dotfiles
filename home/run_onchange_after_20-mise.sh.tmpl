#!/bin/bash
# Install runtimes and dev CLIs. Reruns when the mise config changes:
# {{ include "dot_config/mise/config.toml" | sha256sum }}
set -uo pipefail
[ -n "${DOTFILES_SKIP_PACKAGES:-}" ] && exit 0
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh || { echo "dotfiles: could not install mise" >&2; exit 0; }
fi
mise install --yes || echo "dotfiles: mise install failed; run: mise install" >&2
exit 0
